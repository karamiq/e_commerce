{
  "info": {
    "name": "E-Commerce API",
    "description": "Postman documentation for the NestJS e-commerce backend.\n\n**Base URL:** `{{baseUrl}}` (default `http://localhost:3001/api`)\n\n**Auth:** Most routes expect `Authorization: Bearer {{accessToken}}`.\nRun **Auth / Employee sign in** or **Auth / Customer sign in** first — those requests save tokens to collection variables.\n\n**Responses:** Success bodies are wrapped as `{ data, message, statusCode }`. Paginated lists may also include meta fields.\n\nImport `postman/E-Commerce.postman_collection.json` and `postman/Local.postman_environment.json` into Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "employeeId",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "roleId",
      "value": ""
    },
    {
      "key": "permissionId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "variantId",
      "value": ""
    },
    {
      "key": "attributeId",
      "value": ""
    },
    {
      "key": "attributeValueId",
      "value": ""
    },
    {
      "key": "addressId",
      "value": ""
    },
    {
      "key": "cityId",
      "value": ""
    },
    {
      "key": "governorateId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Public sign-in and token helpers. JWT is also accepted from cookies.",
      "item": [
        {
          "name": "Employee sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/employee/signin",
            "description": "Authenticate an employee and store access/refresh tokens.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employee@example.com\",\n  \"password\": \"SecurePassword123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const payload = json.data || json;",
                  "if (payload.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', payload.accessToken);",
                  "}",
                  "if (payload.refreshToken) {",
                  "  pm.collectionVariables.set('refreshToken', payload.refreshToken);",
                  "}",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Customer sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/customer/signin",
            "description": "Authenticate a customer and store access/refresh tokens.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"SecurePassword123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const payload = json.data || json;",
                  "if (payload.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', payload.accessToken);",
                  "}",
                  "if (payload.refreshToken) {",
                  "  pm.collectionVariables.set('refreshToken', payload.refreshToken);",
                  "}",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/access-token",
            "description": "Issue a new access token from a refresh token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const payload = json.data || json;",
                  "if (payload.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', payload.accessToken);",
                  "}",
                  "if (payload.refreshToken) {",
                  "  pm.collectionVariables.set('refreshToken', payload.refreshToken);",
                  "}",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "description": "Returns the authenticated user payload. Uses the refresh-token guard."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Clears access and refresh cookies."
          }
        },
        {
          "name": "List refresh tokens",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/all-refresh-tokens",
            "description": "Debug helper: list stored refresh tokens.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Remove all refresh tokens",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/auth/remove-refresh-token",
            "description": "Debug helper: delete every stored refresh token.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
